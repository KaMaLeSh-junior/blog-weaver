# =============================================================================
# Environment Variables — copy to .env.local and fill with your own values.
# DO NOT commit .env.local or any file containing real URLs / secrets.
# =============================================================================

# --- Local development (defaults used if not set) ---
VITE_API_BASE_URL=http://localhost:3000/v1/api
VITE_IMAGE_BASE_URL=http://localhost:3000/uploads

# --- Production (example — replace with your own deployed backend) ---
# Versioning lives in the API base URL (e.g. /v1/api, /v2/api).
# The image endpoint path stays standard; only the host changes.
# VITE_API_BASE_URL=https://api.your-domain.com/v1/api
# VITE_IMAGE_BASE_URL=https://api.your-domain.com/uploads
