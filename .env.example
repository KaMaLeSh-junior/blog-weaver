# Environment Variables for API Configuration
# Copy this file to .env.local and update the values

# Local development (default if not set)
VITE_API_BASE_URL=http://localhost:3000/v1/api
VITE_IMAGE_BASE_URL=http://localhost:3000/uploads

# For production, set these:
# VITE_API_BASE_URL=https://your-production-domain.com/v1/api
# VITE_IMAGE_BASE_URL=https://your-production-domain.com/uploads
